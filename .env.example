# =================================================================
# LinkX Environment Configuration Example
# Copy this file to .env and configure values for your environment.
# =================================================================

# Server Port
PORT=3000

# Environment Mode (development / production / test)
NODE_ENV=development

# Optional: Google Gemini API Key for dynamic AI copilot generation
# If not provided, LinkX utilizes high-fidelity built-in heuristic AI engines
GEMINI_API_KEY=

# Optional: GitHub Personal Access Token for real-time repository telemetry
GITHUB_TOKEN=

# Session Secret (Optional - for enhanced cookie / token security)
SESSION_SECRET=linkx-super-secure-production-secret-token-key-2026
